# =============================================================================
# Akash AI Portfolio - Environment Configuration
# =============================================================================
# IMPORTANT: Copy this file to .env and update with your actual values
# NEVER commit .env file to version control (it's in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Groq API Configuration
# Get your API key from: https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=gsk_YOUR_GROQ_API_KEY_HERE

# -----------------------------------------------------------------------------
# Pinecone Configuration
# Get your API key from: https://app.pinecone.io/
# -----------------------------------------------------------------------------
PINECONE_API_KEY=pcsk_YOUR_PINECONE_API_KEY_HERE
PINECONE_INDEX_NAME=your_index_name_here

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment: development, staging, production
APP_ENV=development

# Debug mode: True for development, False for production
DEBUG=True

# Server host and port
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Frontend URL(s) allowed to access this API
# Development: http://localhost:3000
# Production: https://your-domain.com
FRONTEND_URL=http://localhost:3000

# Additional origins (comma-separated if multiple)
# ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

# -----------------------------------------------------------------------------
# Security Settings (Optional - for production)
# -----------------------------------------------------------------------------
# Secret key for session management (generate with: openssl rand -hex 32)
# SECRET_KEY=your_secret_key_here

# API Token for authentication (optional)
# API_TOKEN=your_api_token_here

# -----------------------------------------------------------------------------
# Logging & Monitoring (Optional)
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Sentry DSN for error tracking (optional)
# SENTRY_DSN=https://your_sentry_dsn@sentry.io/your_project_id

# -----------------------------------------------------------------------------
# Database & Caching (Optional - for future features)
# -----------------------------------------------------------------------------
# Redis configuration
# REDIS_URL=redis://localhost:6379/0

# PostgreSQL configuration
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
